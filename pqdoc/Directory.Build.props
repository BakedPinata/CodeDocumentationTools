<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Version>1.27.1</Version>
    <Product>pqdoc</Product>
    <!-- The folder the build stamp follows: see Directory.Build.targets at the root. -->
    <ToolRoot>$(MSBuildThisFileDirectory)</ToolRoot>
    <!-- The shared libraries pqdoc is built from, which its stamp follows too. -->
    <ToolStampPaths>:/shared/src/CodeDocumenter.Shared :/shared/src/CodeDocumenter.Workbooks</ToolStampPaths>
  </PropertyGroup>

</Project>
