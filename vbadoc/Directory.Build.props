<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Shown in generated pages and when vbadoc is asked for its version. Raise it at the end of each stage. -->
    <Version>0.40.0</Version>
    <Product>vbadoc</Product>
    <!-- The folder the build stamp follows: see Directory.Build.targets at the root. -->
    <ToolRoot>$(MSBuildThisFileDirectory)</ToolRoot>
    <!-- The shared libraries vbadoc is built from, which its stamp follows too. -->
    <ToolStampPaths>:/shared/src/CodeDocumenter.Shared :/shared/src/CodeDocumenter.Workbooks :/shared/src/CodeDocumenter.CodeViews</ToolStampPaths>
  </PropertyGroup>

</Project>
