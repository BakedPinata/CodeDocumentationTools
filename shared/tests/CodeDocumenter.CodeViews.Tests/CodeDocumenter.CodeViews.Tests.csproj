<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>CodeDocumenter.CodeViews.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeDocumenter.CodeViews\CodeDocumenter.CodeViews.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The made-up language the browser tests draw, for the tests of the model it's written in. -->
    <Compile Include="..\CodeDocumenter.CodeViews.BrowserTests\Toy.cs" Link="Toy.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
